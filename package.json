{
  "name": "last-light",
  "private": true,
  "version": "1.0.0",
  "description": "LAST LIGHT — a browser-based survival-management roguelite set in an underground vault after the world went quiet.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "tsx scripts/validate-content.ts",
    "simulate": "tsx scripts/simulate.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run lint && npm run test && npm run build",
    "deploy:pages": "tsx scripts/deploy-pages.ts"
  },
  "dependencies": {
    "immer": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.10.1",
    "@testing-library/react": "^16.4.1",
    "@testing-library/user-event": "^14.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.1",
    "jsdom": "^28.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.1"
  },
  "engines": { "node": ">=20" }
}
