{
  "name": "last-light",
  "private": true,
  "version": "1.0.0",
  "description": "LAST LIGHT — a browser-based survival-management roguelite set in an underground vault after the world went quiet.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/locale-report.ts",
    "simulate": "tsx scripts/simulate.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run lint && npm run test && npm run build",
    "deploy:pages": "tsx scripts/deploy-pages.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "locales": "tsx scripts/locale-report.ts"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
